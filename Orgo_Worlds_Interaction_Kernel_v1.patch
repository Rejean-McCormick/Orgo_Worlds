+        "value": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Algorithm-specific value (e.g., hex digest, CID)."
+        },
+        "uri": {
+          "type": "string",
+          "format": "uri",
+          "description": "Optional retrieval location; not identity."
+        }
+      }
+    },
+    "hash_ref": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["alg", "value"],
+      "properties": {
+        "alg": { "type": "string", "minLength": 1 },
+        "value": { "type": "string", "minLength": 1 }
+      }
+    },
+    "stage_record": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["name", "status"],
+      "properties": {
+        "name": {
+          "type": "string",
+          "minLength": 1,
+          "description": "Stage identifier (e.g., ingest, extract, resolve, validate, compile, distribute)."
+        },
+        "status": {
+          "type": "string",
+          "enum": ["PASS", "FAIL", "ERROR", "SKIP"]
+        },
+        "started_at": { "type": "string", "format": "date-time" },
+        "ended_at": { "type": "string", "format": "date-time" },
+        "inputs": {
+          "type": "array",
+          "items": { "$ref": "#/$defs/content_ref" }
+        },
+        "outputs": {
+          "type": "array",
+          "items": { "$ref": "#/$defs/content_ref" }
+        },
+        "metrics": {
+          "type": "object",
+          "additionalProperties": true
+        },
+        "notes": { "type": "string" }
+      }
+    }
+  }
+}
